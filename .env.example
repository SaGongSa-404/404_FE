# 로컬 백엔드 (시뮬/에뮬: localhost·127.0.0.1, Android 에뮬: 10.0.2.2)
API_BASE_URL=http://127.0.0.1:8080

# 실기기 + 로컬 백엔드일 때만 — Mac Wi-Fi IP (USB만으로 localhost 불가)
# Mac: ipconfig getifaddr en0
# API_LAN_HOST=192.168.0.10

# Cloudflare tunnel 등 공개 HTTPS (실기기·시뮬 공용, API_LAN_HOST 불필요)
# API_BASE_URL=https://your-subdomain.trycloudflare.com

# 카카오 네이티브 앱 키 (Android). KAKAO_CLIENT_ID(OAuth)와 다름 — 없으면 비움
KAKAO_NATIVE_APP_KEY=

# POST /api/dev/users/test 응답 userId 붙여넣기
DEV_USER_ID=

# API만 먼저: x_user_id | OAuth 후: bearer
DEV_AUTH_MODE=x_user_id

# Firebase FCM (flutterfire configure 또는 Firebase Console에서 확인)
# 모두 채워야 FCM 토큰 등록·푸시 수신이 활성화됩니다.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
# 선택
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=